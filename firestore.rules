rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /auszahlungen/{dokument} {
      allow read, write: if request.auth != null;
    }
    match /vertraege/{dokument} {
      allow read, write: if request.auth != null;
    }
    match /vertragsformulare/{dokument} {
      allow read, write: if request.auth != null;
    }
    match /vereinbarungen/{dokument} {
      allow read, write: if request.auth != null;
    }
    match /benutzer/{dokument} {
      allow read, write: if request.auth != null;
    }
  }
}
